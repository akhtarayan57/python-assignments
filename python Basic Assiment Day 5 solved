# ============================================================
# STRING MANIPULATION
# ============================================================

string_ = "We are creating next generation data science eco-system at CollegeRanker"

# Length of string
print(len(string_))            # 72

# Access with positive indexing
print(string_[0])              # 'W'

# Access with negative indexing
print(string_[-1])             # 'r'

# Slicing
print(string_[:6])             # 'We are'  (first 6 chars)
print(string_[7:-10])          # 'creating next generation data science eco-system at College'

# Count a character
print(string_.count('e'))      # count of 'e'

# Count a substring
print(string_.count('ing'))    # count of 'ing'

# find and index
print(string_.find('data'))    # returns starting index of 'data', or -1 if not found
print(string_.index('data'))   # returns starting index, gives error if not found

# startswith / endswith
print(string_.startswith('We'))          # True
print(string_.endswith('CollegeRanker')) # True

# Upper case
print(string_.upper())

# Capitalize (first character only)
print(string_.capitalize())

# isLower / isUpper
print(string_.islower())  # False
print(string_.isupper())  # False

# isdigit, isalpha, isalnum
print("12345".isdigit())    # True
print("Hello".isalpha())    # True
print("Hello123".isalnum()) # True

# Replace
new_str = "C++ is easy to learn"
print(new_str.replace("C++", "Python"))  # Python is easy to learn

# Split
print(new_str.split())  # ['C++', 'is', 'easy', 'to', 'learn']

