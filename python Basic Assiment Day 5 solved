# ============================================================
# SCOPE OF VARIABLES
# ============================================================

# Global variable
global_variable = 'variable outside of function'

def random_function():
    return global_variable

print(random_function())  # variable outside of function

# Changing global variable INSIDE function creates a LOCAL copy
global_variable = 'variable outside of function'

def random_function():
    global_variable = 'changing variable outside of function from inside of function'
    return global_variable

print(random_function())   # changing variable outside of function from inside of function
print(global_variable)     # variable outside of function  <-- UNCHANGED globally!
# Note: The global variable is NOT changed! A new local variable was created inside.
